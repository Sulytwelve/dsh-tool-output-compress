{
  "name": "@sulytwelve/dsh-tool-output-compress",
  "version": "0.1.2",
  "description": "Deterministic compression of long shell tool output for DeepSeek Harness: keep errors, stacks, transitions and line references, store complete stdout/stderr as recoverable artifacts.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "tool-output",
    "compression",
    "spill"
  ],
  "license": "MIT",
  "author": "Sulytwelve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sulytwelve/dsh-tool-output-compress.git"
  },
  "homepage": "https://github.com/Sulytwelve/dsh-tool-output-compress#readme",
  "bugs": {
    "url": "https://github.com/Sulytwelve/dsh-tool-output-compress/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-tool-output-compress": "./bin/cli.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "test",
    "docs",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/parse.mjs && node test/summarize.mjs && node test/artifacts.mjs && node test/hook.mjs && node test/cli.mjs && node test/plugin.mjs && node test/nosample.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
